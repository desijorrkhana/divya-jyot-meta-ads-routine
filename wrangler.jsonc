// Cloudflare config: serve this repo as a static site (Workers with assets).
// The name matches the Worker Cloudflare's CI created; .assetsignore keeps
// everything except the dashboard pages out of the served assets.
{
  "name": "divya-jyot-meta-ads-routine-dashboard",
  "compatibility_date": "2026-07-01",
  "preview_urls": false,
  "assets": {
    "directory": "."
  }
}
